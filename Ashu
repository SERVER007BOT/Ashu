const CakeScreen = ({ onNext }) => {
  const [step, setStep] = useState(0);
  
  const handleTap = () => {
    if (step < 4) setStep(s => s + 1);
  };

  return (
    <div 
      className="h-full w-full bg-slate-900 flex flex-col items-center py-16 px-6 text-white cursor-pointer relative"
      onClick={handleTap}
    >
      <h2 className="text-3xl font-bold mt-8 mb-12">Cake first. Obviously. 🎂</h2>
      
      <div className="flex-1 flex flex-col items-center justify-center w-full">
        {/* Cake rendering */}
        <div className="relative flex flex-col items-center justify-end h-64 mb-8">
          {step >= 4 && <div className="text-3xl -mb-1 animate-bounce z-20">🔥</div>}
          {step >= 3 && <div className="w-3 h-10 bg-blue-300 rounded-t-md z-10" />}
          
          {step >= 2 && (
            <div className="w-24 h-12 bg-amber-700 rounded-t-2xl border-b-8 border-amber-900 relative z-10 flex justify-around px-2 pt-2 shadow-lg">
              <div className="w-2 h-2 rounded-full bg-amber-950"></div>
              <div className="w-2 h-2 rounded-full bg-amber-950"></div>
            </div>
          )}
          {step >= 1 && (
            <div className="w-40 h-14 bg-amber-700 rounded-t-2xl border-b-8 border-amber-900 relative z-10 flex justify-around px-4 pt-4 shadow-lg -mt-2">
              <div className="w-2 h-2 rounded-full bg-amber-950"></div>
              <div className="w-2 h-2 rounded-full bg-amber-950"></div>
              <div className="w-2 h-2 rounded-full bg-amber-950"></div>
            </div>
          )}
          {step >= 0 && (
            <div className="w-56 h-16 bg-amber-700 rounded-t-3xl border-b-8 border-amber-900 relative z-10 flex justify-around px-6 pt-5 shadow-lg -mt-2">
              <div className="w-3 h-3 rounded-full bg-amber-950"></div>
              <div className="w-3 h-3 rounded-full bg-amber-950"></div>
              <div className="w-3 h-3 rounded-full bg-amber-950"></div>
              <div className="w-3 h-3 rounded-full bg-amber-950"></div>
            </div>
          )}
        </div>

        {step < 4 ? (
          <p className="text-slate-400 text-sm animate-pulse">Tap anywhere & make a wish 🪄</p>
        ) : (
          <div className="flex flex-col items-center animate-float-up">
            <p className="text-2xl font-serif italic text-yellow-300 mb-6">Happy Birthday, Anmol ✨</p>
            <button 
              onClick={(e) => { e.stopPropagation(); onNext(); }} 
              className="px-8 py-3 bg-blue-600 hover:bg-blue-500 rounded-full text-white font-semibold shadow-lg transition-transform active:scale-95"
            >
              Keep going 💛
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

const BalloonsScreen = ({ onNext }) => {
  const [popped, setPopped] = useState([false, false, false, false]);
  
  const notes = [
    "You make ordinary days feel like they're worth showing up for.",
    "You remember the little things I mention once in passing.",
    "You're the calm I didn't know I needed until I had it.",
    "You make me want to be a better version of myself."
  ];

  const handlePop = (index) => {
    const newPopped = [...popped];
    newPopped[index] = true;
    setPopped(newPopped);
  };

  const allPopped = popped.every(Boolean);

  return (
    <div className="h-full w-full bg-slate-900 flex flex-col p-6 text-white relative">
      <div className="mt-12 mb-8">
        <h2 className="text-3xl font-bold mb-2">Pop the balloons 🎈</h2>
        <p className="text-sm text-slate-400">4 reasons are waiting inside. One pop at a time.</p>
      </div>

      <div className="flex justify-around mb-8 h-24">
        {[0, 1, 2, 3].map(i => (
          !popped[i] ? (
            <div 
              key={i} 
              onClick={() => handlePop(i)}
              className="text-6xl cursor-pointer hover:scale-110 active:scale-90 transition-transform animate-pulse"
              style={{ filter: `hue-rotate(${i * 60}deg)` }}
            >
              🎈
            </div>
          ) : (
            <div key={i} className="w-16 h-16" /> // Placeholder for popped balloon
          )
        ))}
      </div>

      <div className="flex-1 overflow-y-auto space-y-3 pb-24 scrollbar-hide">
        {notes.map((note, i) => (
          popped[i] && (
            <div key={i} className="bg-slate-800/80 p-4 rounded-xl border border-slate-700 animate-float-up">
              <span className="text-xs text-pink-400 font-bold uppercase tracking-wider mb-1 block">Reason No. {i+1}</span>
              <p className="text-slate-200">{note}</p>
            </div>
          )
        ))}
      </div>

      {allPopped && (
        <div className="absolute bottom-8 left-0 right-0 flex flex-col items-center bg-gradient-to-t from-slate-900 pt-8 pb-4 animate-float-up">
          <p className="text-slate-400 text-sm italic mb-4">Still nowhere near all the reasons ✨</p>
          <button 
            onClick={onNext} 
            className="px-8 py-3 bg-blue-600 rounded-full text-white font-semibold shadow-lg active:scale-95"
          >
            Keep going 💛
          </button>
        </div>
      )}
    </div>
  );
};


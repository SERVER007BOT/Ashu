const FinalScreen = () => {
  const [confetti, setConfetti] = useState([]);

  useEffect(() => {
    // Generate random confetti pieces
    const colors = ['bg-pink-500', 'bg-blue-500', 'bg-yellow-400', 'bg-green-500', 'bg-purple-500'];
    const pieces = Array.from({ length: 70 }).map((_, i) => ({
      id: i,
      left: `${Math.random() * 100}%`,
      animationDuration: `${Math.random() * 3 + 2}s`,
      animationDelay: `${Math.random() * 2}s`,
      colorClass: colors[Math.floor(Math.random() * colors.length)]
    }));
    setConfetti(pieces);
  }, []);

  return (
    <div className="h-full w-full bg-slate-900 flex flex-col items-center justify-center p-8 relative overflow-hidden text-center">
      {/* Confetti container */}
      <div className="absolute inset-0 pointer-events-none">
        {confetti.map(c => (
          <div 
            key={c.id}
            className={`confetti ${c.colorClass} rounded-sm`}
            style={{ 
              left: c.left, 
              animationDuration: c.animationDuration, 
              animationDelay: c.animationDelay 
            }}
          />
        ))}
      </div>

      <div className="z-10 animate-float-up flex flex-col items-center">
        <h1 className="text-4xl font-extrabold text-white mb-2 tracking-wide uppercase">
          Happy<br/>Birthday
        </h1>
        <h2 className="text-3xl font-serif italic text-yellow-300 mb-12">Anmol!</h2>
        
        <div className="text-8xl drop-shadow-2xl animate-pulse">
          🧸
        </div>
      </div>

      <div className="absolute bottom-10 z-10 opacity-70 animate-float-up" style={{ animationDelay: '1.5s' }}>
        <p className="text-slate-300 text-sm font-medium">
          Made with love, just for you — Ayushi 🧡
        </p>
      </div>
    </div>
  );
};

// --- Main App Component ---

export default function App() {
  const [currentScreen, setCurrentScreen] = useState(0);

  const nextScreen = () => {
    if (currentScreen < 8) {
      setCurrentScreen(prev => prev + 1);
    }
  };

  const screens = [
    <StartScreen onNext={nextScreen} />,
    <YayScreen onNext={nextScreen} />,
    <BouquetScreen onNext={nextScreen} />,
    <CakeScreen onNext={nextScreen} />,
    <BalloonsScreen onNext={nextScreen} />,
    <PolaroidScreen onNext={nextScreen} />,
    <LetterIntroScreen onNext={nextScreen} />,
    <LetterContentScreen onNext={nextScreen} />,
    <FinalScreen />
  ];

  return (
    <div className="flex justify-center items-center h-screen w-full bg-neutral-950 font-sans selection:bg-pink-300">
      <CustomStyles />
      {/* Mobile container boundary */}
      <div className="w-full max-w-[400px] h-[100dvh] bg-white relative overflow-hidden shadow-2xl sm:rounded-[2.5rem] sm:h-[850px] sm:max-h-[95vh] sm:border-[8px] border-slate-800">
        
        {/* Render current screen */}
        <div className="absolute inset-0 transition-opacity duration-500">
          {screens[currentScreen]}
        </div>

      </div>
    </div>
  );
}
